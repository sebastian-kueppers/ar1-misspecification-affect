# EMOTE data and derived results: never commit
data/raw/*
!data/raw/.gitkeep
!data/raw/summary/
data/raw/summary/*
!data/raw/summary/.gitkeep
data/processed/*
!data/processed/.gitkeep
results/*
!results/.gitkeep

# Coding sheets derived from the EMOTE request summary (regenerated by preprocessing)
inputs/*
!inputs/.gitkeep

# R/RStudio
.Rproj.user/
.Rhistory
.RData
.RDataTmp
